{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.digital-3d.org/v1/asset-registry.schema.json",
  "title": "Asset registry",
  "description": "The catalogue of everything a module publishes for consumption. One entry per selectable or placeable asset. A consuming module resolves urn:d3d:<module>:<id> references through this document and NEVER by reaching into the producer's source tree.",
  "type": "object",
  "properties": {
    "contract_version": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/contract_version" },
    "module_id": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/module_id" },
    "frame_id": {
      "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/id",
      "description": "Scene frame that every scene-space coordinate in this registry is expressed in."
    },
    "ladder_id": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/id" },
    "base_url": {
      "type": "string",
      "description": "Base for resolving every relative payload URL in this document."
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "provenance": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/provenance" }
  },
  "required": ["contract_version", "module_id", "frame_id", "ladder_id", "assets"],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/asset_urn" },
        "kind": {
          "type": "string",
          "enum": ["single", "aggregate", "tileset", "proxy"],
          "description": "'single' is one object. 'aggregate' is a merged batch addressed as one. 'tileset' delegates to a tile index. 'proxy' is a low-cost stand-in for an asset owned by another module."
        },
        "represents": {
          "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/asset_urn",
          "description": "Required when kind='proxy': the foreign asset this stands in for."
        },
        "metadata": { "$ref": "https://contracts.digital-3d.org/v1/metadata.schema.json" },
        "metadata_url": {
          "type": "string",
          "description": "Alternative to inlining metadata, for large registries. Exactly one of metadata or metadata_url MUST be present."
        },
        "bbox": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/bbox_scene" },
        "bbox_geodetic": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/bbox_geodetic" },
        "placement": { "$ref": "https://contracts.digital-3d.org/v1/common.defs.schema.json#/$defs/placement" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "description": "Available representations of this asset, one per LOD level the module actually ships.",
          "items": { "$ref": "#/$defs/variant" }
        },
        "tile_index_url": {
          "type": "string",
          "description": "Required when kind='tileset'."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-form labels a tour script or a UI filter can select on, e.g. 'landmark', 'photo_spot', 'hero_zone'."
        }
      },
      "required": ["asset_id", "kind"],
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "level": { "type": "integer", "minimum": 0 },
        "url": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["glb", "gltf", "3dtiles", "geojson", "json", "ktx2", "none"]
        },
        "byte_size": { "type": "integer", "minimum": 0 },
        "triangle_count": { "type": "integer", "minimum": 0 },
        "max_geometric_error_m": { "type": "number", "minimum": 0 },
        "node_name": {
          "type": "string",
          "description": "Node within the payload that corresponds to this asset, when several assets share one payload file."
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["level", "format"],
      "additionalProperties": false
    }
  }
}
